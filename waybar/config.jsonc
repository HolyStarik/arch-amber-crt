{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 10,
  "modules-left": ["custom/brand", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["cpu", "memory", "clock", "tray"],
  "custom/brand": { "format": "[ ₿  AMBER CRT ]", "tooltip": false },
  "hyprland/workspaces": { "format": "[{name}]", "persistent-workspaces": {"*": 5} },
  "hyprland/window": { "max-length": 48, "separate-outputs": true },
  "cpu": { "format": "CPU {usage}%", "interval": 5 },
  "memory": { "format": "RAM {}%", "interval": 10 },
  "clock": { "format": "{:%Y-%m-%d  %H:%M}", "tooltip": false },
  "tray": { "spacing": 8 }
}